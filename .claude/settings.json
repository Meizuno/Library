{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(ls:*)",
      "Bash(echo:*)",
      "Bash(pytest:*)",
      "Bash(pylint:*)",
      "Bash(*python.exe -m pytest*)",
      "Bash(*python.exe -m pylint*)",
      "Bash(*python -m pytest*)",
      "Bash(*python -m pylint*)",
      "Edit(library/**)",
      "Edit(tests/**)",
      "Edit(.claude/**)",
      "Edit(*.md)",
      "Edit(*.toml)",
      "Edit(.gitignore)",
      "Edit(.env.example)",
      "Write(library/**)",
      "Write(tests/**)",
      "Write(.claude/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard main)",
      "Bash(git reset --hard origin/main:*)",
      "Edit(.env)",
      "Write(.env)"
    ]
  }
}
